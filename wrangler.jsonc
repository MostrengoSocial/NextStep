{
  // nextStep: Cloudflare Worker serving the React site plus the contact API.
  // Lives at the repo root so Cloudflare's default "npx wrangler deploy" finds it.
  "$schema": "./frontend/node_modules/wrangler/config-schema.json",
  // Must match the Worker's name in the Cloudflare dashboard exactly.
  "name": "nextstep",
  "main": "frontend/worker/index.js",
  "compatibility_date": "2025-09-01",
  // wrangler runs this before every deploy, so the site is always rebuilt.
  "build": {
    "command": "npm --prefix frontend ci && npm --prefix frontend run build"
  },
  "assets": {
    "directory": "./frontend/build",
    "binding": "ASSETS",
    // Pages are prerendered files; unknown addresses answer 404 with build/404.html.
    "not_found_handling": "404-page",
    // The Worker runs first for every request: redirects, security headers, caching, the API.
    "run_worker_first": true
  },
  "vars": {
    "SENDER_EMAIL": "website@nextstep.com.pt",
    "NOTIFICATION_EMAIL": "hello@nextstep.com.pt"
  },
  // Contact form email: Cloudflare Email Service. nextstep.com.pt must be onboarded
  // under Email Service > Email Sending (Workers Paid plan).
  "send_email": [{ "name": "EMAIL" }],
  "observability": { "enabled": true }
}
